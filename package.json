{
  "name": "fieldcore",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first field operations platform for connectivity-constrained geoscience, mining, surveying, and industrial field environments",
  "scripts": {
    "build": "pnpm -r --filter=!@fieldcore/web build",
    "test": "pnpm -r --filter=!@fieldcore/web test && pnpm --filter @fieldcore/web test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "db:clean": "pnpm --filter @fieldcore/database db:clean"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@11.25.0"
}
